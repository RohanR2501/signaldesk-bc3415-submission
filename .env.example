# Read from repository root. Copy to .env only when overriding defaults.
SIGNALDESK_ENVIRONMENT=development
SIGNALDESK_LOG_LEVEL=INFO
SIGNALDESK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Reserved SQLite path; the current application does not create a database.
SIGNALDESK_DATABASE_PATH=.runtime/signaldesk.sqlite3

# Existing local sentiment artifacts; missing models produce fallback/unavailable states.
SIGNALDESK_TRANSFORMER_DIRECTORY=artifacts/sentiment/distilbert-weighted-v1
SIGNALDESK_BASELINE_DIRECTORY=artifacts/sentiment/baselines-v1
