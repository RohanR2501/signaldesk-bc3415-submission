{
  "version": "sentiment-baselines-v1",
  "dataset_directory": "data/processed/appliances-v1",
  "annotation_directory": "data/annotations/sentiment-v1",
  "artifact_directory": "artifacts/sentiment/baselines-v1",
  "seed": 3415,
  "expected_training_rows": 32230,
  "expected_validation_rows": 6913,
  "annotation_per_class": 80,
  "cpu_threads": 4,
  "tfidf": {
    "max_features": 60000,
    "ngram_range": [1, 2],
    "min_df": 2,
    "lowercase": true,
    "sublinear_tf": true,
    "token_pattern": "(?u)\\b\\w+(?:['’]\\w+)*\\b|[!?]+"
  },
  "naive_bayes_alpha": 1.0,
  "logistic_regression": {
    "C": 1.0,
    "solver": "lbfgs",
    "max_iter": 500,
    "tol": 0.0001
  },
  "selection_metric": "macro_f1",
  "label_source": "rating_proxy_v1"
}
